#!/usr/bin/env bash
set -euo pipefail

_norm="$(dirname "$0")/_normalize-hooks-path.sh"
[ -f "$_norm" ] && . "$_norm"

cd "$(git rev-parse --show-toplevel)"

# Drain the pushed refs on stdin, or git sees a broken pipe.
cat > /dev/null || true

LOGDIR=$(mktemp -d)
trap 'rm -rf "$LOGDIR"' EXIT

STEPS=(
  'cd apps/backend && make test'
  'cd apps/backend && make deadcode'
  'cd apps/backend && make lint-ci'
  'cd apps/backend && make check-format'
  'cd apps/backend && make check-quiz'
)

run_step() {
    local index="$1"
    local cmd="$2"
    local logfile="$LOGDIR/step-$index.log"

    if bash -c "$cmd" > "$logfile" 2>&1; then
        echo "pre-push: ✓ $cmd"
    else
        echo "pre-push: ✗ $cmd — output:"
        cat "$logfile"
        return 1
    fi
}

PIDS=()
for i in "${!STEPS[@]}"; do
    echo "pre-push: starting ${STEPS[$i]}..."
    run_step "$i" "${STEPS[$i]}" &
    PIDS+=($!)
done

FAILED=0
for pid in "${PIDS[@]}"; do
    wait "$pid" || FAILED=1
done

if [ "$FAILED" -ne 0 ]; then
    echo "pre-push: one or more checks failed."
    exit 1
fi

echo "pre-push: all checks passed."
