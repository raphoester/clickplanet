#!/usr/bin/env bash
set -euo pipefail

_norm="$(dirname "$0")/_normalize-hooks-path.sh"
[ -f "$_norm" ] && . "$_norm"

cd "$(git rev-parse --show-toplevel)"

# Read every pushed ref on stdin, or git sees a broken pipe.
PUSHED=$(cat || true)

# What the backend's checks read: its code, the shared files it copies, and the deploy files its tests load.
BACKEND_INPUTS=(apps/backend proto quiz docs/moderation.md deploy)

# True when a pushed commit changes a backend input, and when the hook cannot tell.
touches_backend() {
    local local_sha remote_sha base
    while read -r _ local_sha _ remote_sha; do
        if [ -z "$local_sha" ] || [[ "$local_sha" =~ ^0+$ ]]; then
            continue
        fi
        if [[ "$remote_sha" =~ ^0+$ ]]; then
            base=$(git merge-base origin/main "$local_sha" 2>/dev/null) || return 0
        else
            base=$remote_sha
        fi
        git diff --quiet "$base" "$local_sha" -- "${BACKEND_INPUTS[@]}" 2>/dev/null || return 0
    done <<< "$PUSHED"
    return 1
}

if ! touches_backend; then
    echo "pre-push: no backend input changed, backend checks skipped."
    exit 0
fi

LOGDIR=$(mktemp -d)
trap 'rm -rf "$LOGDIR"' EXIT

STEPS=(
  'cd apps/backend && make test'
  'cd apps/backend && make deadcode'
  'cd apps/backend && make lint-ci'
  'cd apps/backend && make check-format'
  'cd apps/backend && make check-quiz'
  'cd apps/backend && make check-moderation'
  'cd apps/backend && make check-migrations BASE=origin/main'
)

run_step() {
    local index="$1"
    local cmd="$2"
    local logfile="$LOGDIR/step-$index.log"

    if bash -c "$cmd" > "$logfile" 2>&1; then
        echo "pre-push: ✓ $cmd"
    else
        echo "pre-push: ✗ $cmd — output:"
        cat "$logfile"
        return 1
    fi
}

PIDS=()
for i in "${!STEPS[@]}"; do
    echo "pre-push: starting ${STEPS[$i]}..."
    run_step "$i" "${STEPS[$i]}" &
    PIDS+=($!)
done

FAILED=0
for pid in "${PIDS[@]}"; do
    wait "$pid" || FAILED=1
done

if [ "$FAILED" -ne 0 ]; then
    echo "pre-push: one or more checks failed."
    exit 1
fi

echo "pre-push: all checks passed."
