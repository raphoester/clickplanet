#!/usr/bin/env bash
# Point git at the hooks in this directory. Run once per clone:
#
#     ./.githooks/install
#
# Deliberately a script and not a root Makefile: this repo keeps its build
# tooling inside each app (see CLAUDE.md), and git hooks are the one thing that
# is genuinely repo-wide.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Relative, so each worktree runs its own copy — see _normalize-hooks-path.sh.
git config core.hooksPath .githooks

if [ "$(git config --bool --get extensions.worktreeConfig 2>/dev/null || true)" = "true" ]; then
    git config --worktree core.hooksPath .githooks
fi

chmod +x .githooks/pre-commit .githooks/commit-msg .githooks/pre-push

echo "hooks installed: pre-commit, commit-msg, pre-push"
echo "bypass any of them with --no-verify."
