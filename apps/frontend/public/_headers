/assets/*
  Cache-Control: public, max-age=31536000, immutable

/static/*
  Cache-Control: public, max-age=604800

# "!" first: Cloudflare joins a header two rules set, and the /static/* week would win.
/static/coordinates-*.bin
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/static/countries/atlas-*.png
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=3600

/sitemap.xml
  ! Cache-Control
  Cache-Control: public, max-age=3600

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/play
  Cache-Control: public, max-age=0, must-revalidate

/auth/callback
  Cache-Control: public, max-age=0, must-revalidate
  Referrer-Policy: no-referrer
