/assets/*
  Cache-Control: public, max-age=31536000, immutable

/static/*
  Cache-Control: public, max-age=604800

# "!" first: Cloudflare joins a header two rules set, and the /static/* week would win.
/static/coordinates-*.bin
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/static/landmask-*.bin
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/static/countries/atlas-*.png
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/static/borders-*.bin
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/static/capitals-*.json
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/static/waters-*.json
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/static/borderLines-*.bin
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/static/earth/earth-*.jpg
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/static/og-image-*.jpg
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/static/reactions/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/static/anthems/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=3600

/sitemap.xml
  ! Cache-Control
  Cache-Control: public, max-age=3600

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/play
  Cache-Control: public, max-age=0, must-revalidate

/video
  Cache-Control: public, max-age=0, must-revalidate

/auth/callback
  Cache-Control: public, max-age=0, must-revalidate
  Referrer-Policy: no-referrer

# The CrazyGames host is the same build, framed by CrazyGames: kept out of Google so it never competes with clickplanet.lol.
https://crazygames.clickplanet.lol/*
  X-Robots-Tag: noindex
