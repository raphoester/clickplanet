/assets/*
  Cache-Control: public, max-age=31536000, immutable

/static/*
  Cache-Control: public, max-age=604800

# "!" first: Cloudflare joins a header two rules set, and the /static/* week would win.
/static/boards/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/static/countries/atlas-*.png
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/static/waters-*.json
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/static/og-image-*.jpg
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/static/reactions/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/static/anthems/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=3600

/sitemap.xml
  ! Cache-Control
  Cache-Control: public, max-age=3600

# The pages that load /assets/ files are never kept: a copy kept and shown again (iOS restores a tab from its cache)
# runs an older build, whose files the last deploy removed (docs/stale-build.md).
/
  Cache-Control: no-store

/index.html
  Cache-Control: no-store

/play
  Cache-Control: no-store

/archive
  Cache-Control: no-store

/video
  Cache-Control: no-store

/auth/callback
  Cache-Control: no-store
  Referrer-Policy: no-referrer

# The CrazyGames host is the same build, framed by CrazyGames: kept out of Google so it never competes with clickplanet.lol.
https://crazygames.clickplanet.lol/*
  X-Robots-Tag: noindex
