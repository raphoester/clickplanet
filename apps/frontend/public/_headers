# Content-hashed bundles never change under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Textures, flags and the sprite atlas change only when regenerated.
/static/*
  Cache-Control: public, max-age=604800

# The tile coordinates blob is content-addressed: regenerating the map ships it
# under a new file name, so this can outlive the /static/* week above.
#
# The `!` detaches the header the broader /static/* rule already applied. Both
# rules match this path, and Cloudflare *joins* the values of a header applied
# twice rather than letting the more specific rule win — without the detach the
# response carries `max-age=604800, max-age=31536000`, and the week wins.
/static/coordinates-*.bin
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# The sprite atlas is content-addressed the same way, for the same reason: it
# used to defeat the cache entirely with a `?ts=` query string on every load.
/static/countries/atlas-*.png
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Crawler files: short cache so a change is picked up without a week's delay.
/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=3600

/sitemap.xml
  ! Cache-Control
  Cache-Control: public, max-age=3600

/index.html
  Cache-Control: public, max-age=0, must-revalidate
