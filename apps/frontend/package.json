{
  "name": "clickplanet.lol-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dBuild": "docker build -t clickplanet-front:local .",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && npm run copy:static",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "mobile": "node scripts/mobile.mjs",
    "preview": "vite preview",
    "proto": "npx buf generate",
    "atlas": "vite-node scripts/generateAtlas.ts --",
    "og-image": "vite-node scripts/generateOgImage.ts",
    "coordinates": "vite-node scripts/computeCoordinates.ts --",
    "coordinates:convert": "vite-node scripts/convertCoordinates.ts",
    "copy:static": "rm -rf dist/static && mkdir -p dist/static && cp -R static/. dist/static/ && rm -f dist/static/coordinates.json dist/static/og-source.png && { ls dist/static/coordinates-*.bin >/dev/null 2>&1 || { echo \"copy:static: static/coordinates-<hash>.bin is missing - run 'npm run coordinates:convert'\" >&2; exit 1; }; }",
    "borders": "node scripts/generateBorders.mjs",
    "flagFit": "node scripts/generateFlagFit.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.0",
    "@connectrpc/connect": "^1.7.0",
    "@connectrpc/connect-web": "^1.7.0",
    "moment-timezone": "^0.5.46",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.47.2",
    "@bufbuild/protoc-gen-es": "^1.10.0",
    "@connectrpc/protoc-gen-connect-es": "^1.7.0",
    "@eslint/js": "^9.13.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/spritesmith": "^3.4.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "jsdom": "^27.0.1",
    "sharp": "^0.33.5",
    "spritesmith": "^3.5.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vite-node": "^2.1.5",
    "vite-plugin-glsl": "^1.3.0",
    "vitest": "^2.1.4",
    "wrangler": "^4.129.0"
  }
}
