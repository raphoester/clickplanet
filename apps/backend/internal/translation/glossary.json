{
  "terms": [
    {
      "en": "tile",
      "means": "one cell of the globe; a click takes it for your flag",
      "fr": "case", "de": "Feld", "tr": "kare", "pt-BR": "casa", "pl": "pole", "id": "petak", "es": "casilla", "cs": "pole"
    },
    {
      "en": "flag",
      "means": "the country a player plays for, and its team; also the flag drawn on the tiles",
      "fr": "drapeau", "de": "Flagge", "tr": "bayrak", "pt-BR": "bandeira", "pl": "flaga", "id": "bendera", "es": "bandera", "cs": "vlajka"
    },
    {
      "en": "click",
      "means": "one take of a tile; a player holds a bank of clicks that refills over time",
      "fr": "clic", "de": "Klick", "tr": "tık", "pt-BR": "clique", "pl": "klik", "id": "klik", "es": "clic", "cs": "klik"
    },
    {
      "en": "take (a tile)",
      "means": "to click a tile and make it your flag's",
      "fr": "prendre", "de": "erobern", "tr": "almak", "pt-BR": "tomar", "pl": "zająć", "id": "merebut", "es": "tomar", "cs": "obsadit"
    },
    {
      "en": "shield",
      "means": "a charge put on one of your tiles; each shield stops one enemy click",
      "fr": "bouclier", "de": "Schild", "tr": "kalkan", "pt-BR": "escudo", "pl": "tarcza", "id": "perisai", "es": "escudo", "cs": "štít"
    },
    {
      "en": "fortify",
      "means": "a take that makes a landmass all yours gives each of its tiles a shield",
