# Automatic HTTPS via Let's Encrypt, using the ACME DNS-01 challenge.
#
# Unlike the default HTTP-01 flow, nothing here needs port 80 reachable from
# the public internet: the origin sits behind Cloudflare's proxy, and ufw only
# admits Cloudflare's ranges on 80/443. Requires the caddy-dns/cloudflare
# plugin, which is why caddy/Dockerfile builds a custom image.

# Every request arrives from Cloudflare, so without this the access log records
# a Cloudflare address as the client and the real visitor is only visible
# buried in a header. Anything built on client IP later — rate limiting, an
# abuse investigation — would silently be looking at the wrong address.
#
# These are Cloudflare's published ranges (cloudflare.com/ips-v4, ips-v6), the
# same set bootstrap.sh admits through ufw. They change very rarely; refresh
# both together if they ever do.
{
	servers {
		client_ip_headers Cf-Connecting-Ip
		trusted_proxies static \
			173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
			141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 \
			197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
			104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
			2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
			2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

{$API_DOMAIN} {
	# ACME DNS-01 instead of the default HTTP-01. Caddy proves control of the
	# domain by writing a TXT record through the Cloudflare API, so it never
	# needs an inbound connection on :80. That is what allows the A record to
	# stay proxied (orange cloud) and the origin IP to stay private — including
	# at every renewal, not just first issuance.
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}

	encode zstd gzip

	# CORS: the frontend is served from a different origin (Cloudflare Pages),
	# so both preflight and actual requests need these.
	header {
		Access-Control-Allow-Origin "{$FRONTEND_ORIGIN}"
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		# X-Session-Token is what a click carries to prove it came from a caller
		# that passed Turnstile. A custom header makes the cross-origin POST
		# preflighted, and a preflight that does not list it fails the click
		# before the API ever sees it — so omitting it here refuses every click
		# from the deployed frontend. The Go CORS middleware carries the same
		# list for anything that reaches it directly.
		Access-Control-Allow-Headers "Content-Type, Connect-Protocol-Version, Connect-Timeout-Ms, X-Session-Token"
		Vary "Origin"
		-Server
	}

	# Answer preflight here — the Go API does not handle OPTIONS.
	# handle blocks are mutually exclusive and evaluated in order, so this
	# must come before the proxy blocks below.
	@options method OPTIONS
	handle @options {
		respond 204
	}

	# X-Real-IP is what the API keys its per-IP rate limiting and its click
	# metrics on. Setting it here (rather than only forwarding it) matters
	# twice over: the socket the backend sees is Caddy's, and a client is free
	# to send an X-Real-IP of its own — header_up without a `+` replaces the
	# incoming value, so a forged one cannot buy a fresh bucket. {client_ip} is
	# the address resolved through client_ip_headers/trusted_proxies above,
	# i.e. Cf-Connecting-Ip, the real visitor.

	# Connect names its own path. GetMap and MapDensity arrive as GETs and
	# carry their own Cache-Control, so a cache in front can serve them.
	handle /planet.v1.ClickService/* {
		reverse_proxy backend:8080 {
			header_up X-Real-IP {client_ip}
		}
	}

	# Sessions are a third proto package, so they get a third path for free.
	# CreateSession is a POST that answers no-store: a minted token belongs to
	# one caller at one address, so nothing in front of this may hold onto it.
	# It keys on X-Real-IP twice over — the token is bound to that address, and
	# minting is throttled per address.
	handle /session.v1.SessionService/* {
		reverse_proxy backend:8080 {
			header_up X-Real-IP {client_ip}
		}
	}

	# Chat is its own proto package, so Connect gives it a path of its own.
	# Both of its RPCs key on X-Real-IP: SendMessage is throttled and block
	# listed per address, and the sender's tag is derived from it.
	# GetHistory arrives as a GET but answers no-store, so nothing in front
	# holds onto it.
	handle /chat.v1.ChatService/* {
		reverse_proxy backend:8080 {
			header_up X-Real-IP {client_ip}
		}
	}

	# Prometheus metrics — closed by default. Uncomment and restrict by source
	# IP if you attach a scraper.
	# handle /metrics {
	#     @internal remote_ip 10.0.0.0/8
	#     reverse_proxy @internal backend:8080
	# }

	handle {
		respond "not found" 404
	}

	log {
		output stdout
		format console
	}
}
