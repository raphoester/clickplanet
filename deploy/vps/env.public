# Settings that are not secret, copied verbatim into the generated .env by
# render-env.sh. They live in git rather than in Actions secrets so a change to
# either shows up in a diff — a hostname nobody can read protects nothing.
#
# Everything here is a setting docker-compose.yaml has no sensible default for.
# BACKEND_IMAGE, CADDY_IMAGE, POLL_INTERVAL and POLL_RETENTION_DAYS are absent
# on purpose: compose already defaults all four, and repeating a default here
# turns one value into two that have to be kept in step.

# Domain fronting this box. Its A record holds the droplet IP but must be
# PROXIED (orange cloud): ufw admits only Cloudflare on 80/443, and Caddy gets
# its cert over DNS-01, so the origin is never contacted directly.
API_DOMAIN=api.clickplanet.lol

# Origin allowed to call the API — the Cloudflare Pages domain.
FRONTEND_ORIGIN=https://clickplanet.lol
