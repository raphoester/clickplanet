# Copy to .env on the VPS: cp .env.example .env && $EDITOR .env

# Domain pointing at this box (A record). Caddy issues a cert for it.
API_DOMAIN=api.clickplanet.lol

# Origin allowed to call the API — your Cloudflare Pages domain.
FRONTEND_ORIGIN=https://clickplanet.lol

# Image built and pushed by .github/workflows/deploy-backend.yml
BACKEND_IMAGE=ghcr.io/raphoester/clickplanet-backend:latest
