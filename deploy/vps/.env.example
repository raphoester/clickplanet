CLOUDFLARE_API_TOKEN=

CHAT_TAG_SALT=

SESSION_SECRET=

TURNSTILE_SECRET=

GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_SECRET=

# Email Sending: Edit only. Not CLOUDFLARE_API_TOKEN, which edits DNS.
CLOUDFLARE_EMAIL_TOKEN=

# Brevo, season emails: an API key, and the token its unsubscribe webhook sends (openssl rand -hex 32).
BREVO_API_KEY=
BREVO_WEBHOOK_SECRET=

# Set once: postgres keeps the first one in its volume, so a change locks the API out.
POSTGRES_PASSWORD=

