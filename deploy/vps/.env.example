CLOUDFLARE_API_TOKEN=

CHAT_TAG_SALT=

SESSION_SECRET=

TURNSTILE_SECRET=

GOOGLE_CLIENT_SECRET=
# The admin page's own Google client, apart from the game's.
ADMIN_GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_SECRET=

# Email Sending: Edit only. Not CLOUDFLARE_API_TOKEN, which edits DNS.
CLOUDFLARE_EMAIL_TOKEN=

# The secret half of the key to the bucket of the notes' photos and videos.
MEDIA_BUCKET_SECRET=

# The chat's judge of player reports, and the clips' judge of player names (Claude Haiku). Unset, every report
# waits for the operator, and no clip names a player.
ANTHROPIC_API_KEY=

# The game's posting service (Zernio), for the backend's publishing module; the clips workflows hold it as an
# Actions secret of the same name. Unset, the server posts nothing.
ZERNIO_API_KEY=

# Set once: postgres keeps the first one in its volume, so a change locks the API out.
POSTGRES_PASSWORD=

# The backend and redis read the same one; a change takes effect when both restart.
REDIS_PASSWORD=

