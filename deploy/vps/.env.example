# Copy to .env on the VPS: cp .env.example .env && $EDITOR .env

# Domain fronting this box. Its A record holds the droplet IP but must be
# PROXIED (orange cloud): ufw admits only Cloudflare on 80/443, and Caddy gets
# its cert over DNS-01, so the origin is never contacted directly.
API_DOMAIN=api.clickplanet.lol

# Origin allowed to call the API — your Cloudflare Pages domain.
FRONTEND_ORIGIN=https://clickplanet.lol

# Cloudflare API token Caddy uses for the ACME DNS-01 challenge. Create at
# dash.cloudflare.com > My Profile > API Tokens > Create Token > Custom:
#   Permissions: Zone / DNS / Edit  and  Zone / Zone / Read
#   Zone Resources: Include / Specific zone / clickplanet.lol
# This is the only secret on the box. Scope it to the one zone, not All Zones.
CLOUDFLARE_API_TOKEN=

# Salts the per-sender chat tag (the 6 hex characters beside a name in chat).
# Generate once with `openssl rand -hex 16` and then leave it alone: changing it
# renames every sender at the same time, and an empty value makes the API
# generate a new one on every restart. bootstrap.sh writes one here if the file
# does not have one; it never overwrites an existing value.
CHAT_TAG_SALT=

# Signs the session tokens the Click RPC requires. Generate once with
# `openssl rand -hex 32`. Rotating it is cheap — every client mints again on its
# next click — but an empty value makes the API generate one per restart, which
# does the same thing on every deploy.
SESSION_SECRET=

# Secret key of the Turnstile widget, from dash.cloudflare.com > Turnstile >
# your widget > Settings. Its sitekey is the public half and belongs in the
# frontend build as VITE_TURNSTILE_SITEKEY — do not swap the two. The widget's
# allowed domains must list FRONTEND_ORIGIN's host, and must NOT list localhost
# for a production widget.
TURNSTILE_SECRET=

# Images built and pushed by .github/workflows/deploy-backend.yml. Nothing is
# compiled on the droplet — it only pulls.
BACKEND_IMAGE=ghcr.io/raphoester/clickplanet-backend:latest
CADDY_IMAGE=ghcr.io/raphoester/clickplanet-caddy:latest

# The metrics poller (cp-metrics-poller in docker-compose.yaml). Both are
# optional; the defaults below apply when unset. The poller exists because the
# API's counters and histograms live in its process and a deploy resets every
# one of them to zero — it appends the shadowban and click series to the
# metrics_history volume so two samples days apart can be subtracted.
POLL_INTERVAL=300
POLL_RETENTION_DAYS=14
